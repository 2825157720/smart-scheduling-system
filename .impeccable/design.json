      "css": ".ds-paper-card{padding:16px;color:#252522;background:#FFFDF7;border:3px solid #252522;border-radius:12px 8px 14px 7px/8px 13px 7px 12px;box-shadow:4px 4px 0 #252522}.ds-paper-card h3{margin:0 0 8px;font:400 18px/1.25 Kalam,'LXGW WenKai Screen',cursive;text-decoration:underline wavy #C7363E;text-underline-offset:5px}.ds-paper-card p{margin:0;color:#595750;font:400 14px/1.5 system-ui,sans-serif}.ds-paper-card:focus-within{outline:3px solid #2358A5;outline-offset:3px}"
