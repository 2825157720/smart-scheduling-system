      "css": ".ds-btn-secondary{min-height:32px;padding:7px 12px;color:#252522;background:#FFFDF7;border:2px solid #252522;border-radius:8px;box-shadow:2px 2px 0 #252522;font:600 13px/1.35 system-ui,sans-serif;cursor:pointer}.ds-btn-secondary:hover{background:#FFF1A8}.ds-btn-secondary:focus-visible{outline:3px solid #2358A5;outline-offset:3px}.ds-btn-secondary:active{box-shadow:1px 1px 0 #252522}"
