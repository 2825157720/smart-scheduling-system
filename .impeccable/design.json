  "narrative": {
    "northStar": "值班室里的手写排班册",
    "overview": "界面像一本长期放在值班室桌面的排班册：米白纸、墨线、标记笔和便利贴带来真实手作感，高密度排班数据仍保持规整、清晰和可快速扫描。表达力集中在页面外壳、标题、备忘录、统计卡与弹窗；排班网格、姓名、日期、数字和表单控件服从操作效率。\n\n装饰是信息层级的标点，不是独立内容。胶带、图钉、圆点纸和轻微倾斜只出现在静态纸卡；排班表、工具栏、弹窗、表单与右键菜单始终端正。",
    "keyCharacteristics": [
      "手绘纸张外壳包裹稳定功能核心。",
      "墨线和硬阴影提供触感，鲜色只标动作、状态与重点。",
      "所有状态同时使用颜色与文字或符号，不只依赖颜色。"
    ],
    "rules": [
      {
        "name": "The Ink First Rule",
        "body": "大面积背景保持纸张中性色；鲜色只用于动作、状态和少量标记，不把高密度界面染成彩色面板。",
        "section": "colors"
      },
      {
        "name": "The Dense Data Rule",
        "body": "手写字体不得进入动态姓名、日期数字、输入值、按钮标签和排班表单元格；数据数字启用等宽数字。",
        "section": "typography"
      },
      {
        "name": "The Hard Shadow Rule",
        "body": "阴影只做纯偏移且无模糊；排班单元格、表头和表单字段不得使用纸卡硬阴影。",
        "section": "elevation"
      },
      {
        "name": "The Uniform Date Column Rule",
        "body": "所有可见日期列按当月最长姓名统一扩宽；隐藏日期不重新分配空余宽度，拆分槽固定各占 50%，姓名不得省略。",
        "section": "layout"
      },
      {
        "name": "The Assignment Provenance Rule",
        "body": "岗位同步只重算今天及未来的自动格；人工格保持原值，legacy 格须经用户确认后才能转为自动格。",
        "section": "components"
      }
    ],
    "dos": [
      "Do 让纸张、墨线和文具色服务于可读层级。",
      "Do 为键盘焦点、粗指针和减少动效偏好提供完整状态。",
      "Do 保持排班表、粘性表头和拆分格精确对齐。"
    ],
    "donts": [
      "Don't 使用噪点图、手绘 SVG、滤镜、backdrop-filter 或逐单元格硬阴影。",
      "Don't 让胶带、图钉或旋转遮挡交互区域。",
      "Don't 通过主题改动 /api/*、排班算法或既有 DOM ID/handler 契约。"
    ]
  }
}
