{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smart-scheduling-system-base",
  "main": "src/index.js",
  "compatibility_date": "2026-07-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html", "/login", "/login.html"]
  },
  "env": {
    "preview": {
      "name": "smart-scheduling-system-preview",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "WRITE_MODE": "enabled",
        "AUTH_MODE": "enabled"
      },
      "secrets": {
        "required": ["AUTH_CREDENTIAL", "AUTH_SESSION_SECRET"]
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "smart-scheduling-preview",
          "database_id": "e96bd9c5-afeb-4405-a3da-851620b1f31e"
        }
      ]
    },
    "production": {
      "name": "paiban",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "WRITE_MODE": "enabled",
        "AUTH_MODE": "enabled"
      },
      "secrets": {
        "required": ["AUTH_CREDENTIAL", "AUTH_SESSION_SECRET"]
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.25
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "smart-scheduling-production",
          "database_id": "a31cca3c-92c8-4f11-b5c7-42172c5da53e"
        }
      ]
    }
  }
}
